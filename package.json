{
  "name": "webappx",
  "private": true,
  "version": "3.4.0",
  "type": "module",
  "description": "Public React/Vite/Firebase template with managed SYSTEMX tooling, agent coordination, LAN builder and production kits.",
  "scripts": {
    "dev": "vite",
    "dev:firebase": "node .SYSTEMX/LAN/dev-session.mjs",
    "dev:firebase:raw": "npx --no-install firebase-tools emulators:start --only auth,firestore,storage --project demo-systemx",
    "dev:systemx": "node .SYSTEMX/LAN/dev-session.mjs",
    "lan": "node .SYSTEMX/LAN/server.mjs",
    "systemx:lan": "node .SYSTEMX/LAN/server.mjs",
    "systemx:session:status": "node .SYSTEMX/LAN/session-control.mjs status",
    "systemx:session:stop": "node .SYSTEMX/LAN/session-control.mjs stop",
    "systemx:session:restart:preview": "node .SYSTEMX/LAN/session-control.mjs restart --preview",
    "systemx:session:test": "node --test .SYSTEMX/LAN/tests/session-supervisor.test.mjs .SYSTEMX/LAN/tests/session-restart-preview.test.mjs",
    "build": "tsc -b --noCheck && vite build && node .SYSTEMX/scripts/assert-lan-isolation.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test .SYSTEMX/LAN/tests/characterization.test.mjs tests/security/controls.test.mjs",
