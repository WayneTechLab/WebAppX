{
  "name": "webappx",
  "private": true,
  "version": "3.4.0",
  "type": "module",
  "description": "Public React/Vite/Firebase template with managed SYSTEMX tooling, agent coordination, LAN builder and production kits.",
  "scripts": {
    "dev": "vite",
    "dev:firebase": "node .SYSTEMX/LAN/dev-session.mjs",
    "dev:firebase:raw": "npx --no-install firebase-tools emulators:start --only auth,firestore,storage --project demo-systemx",
    "dev:systemx": "node .SYSTEMX/LAN/dev-session.mjs",
    "lan": "node .SYSTEMX/LAN/server.mjs",
    "systemx:lan": "node .SYSTEMX/LAN/server.mjs",
    "systemx:session:status": "node .SYSTEMX/LAN/session-control.mjs status",
    "systemx:session:stop": "node .SYSTEMX/LAN/session-control.mjs stop",
    "build": "tsc -b --noCheck && vite build && node .SYSTEMX/scripts/assert-lan-isolation.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test .SYSTEMX/LAN/tests/characterization.test.mjs tests/security/controls.test.mjs",
    "emulators": "npx --yes firebase-tools emulators:start",
    "emulators:export": "npx --yes firebase-tools emulators:start --export-on-exit=.emulator-data --import=.emulator-data",
    "deploy": "bash .SYSTEMX/scripts/deploy.sh",
    "system:audit": "bash .SYSTEMX/scripts/system-audit.sh",
    "sync:system": "bash .SYSTEMX/wsg-agi.sh",
    "sync:system:check": "bash .SYSTEMX/wsg-agi.sh --check",
    "docs:links": "node .SYSTEMX/scripts/validate-markdown-links.mjs",
    "research:validate": "python3 .SYSTEMX/LAN/Research/LAN-Builder/tools/validate_package.py",
    "setup:unified:scrape:list": "node .SYSTEMX/Unified-Setup-Process/scrape/repo-manifest-scraper.mjs --list",
    "setup:unified:scrape:dry-run": "node .SYSTEMX/Unified-Setup-Process/scrape/repo-manifest-scraper.mjs --dry-run",
    "setup:unified:scrape": "node .SYSTEMX/Unified-Setup-Process/scrape/repo-manifest-scraper.mjs --write",
    "setup:packet:export": "bash .SYSTEMX/scripts/build-setup-packet.sh",
    "setup:packet:import": "bash .SYSTEMX/scripts/import-setup-packet.sh",
    "setup:test-users": "node scripts/setup/seed-test-users.mjs",
    "setup:test-users:write": "node scripts/setup/seed-test-users.mjs --write",
    "account-levels:check": "node .SYSTEMX/scripts/account-level-check.mjs",
    "auth:mfa:check": "node .SYSTEMX/scripts/auth-mfa-readiness-check.mjs",
    "ai:standard:check": "node .SYSTEMX/scripts/agent-standard-check.mjs",
    "browser:install": "npx playwright install chromium",
    "browser:codegen": "npx playwright codegen http://localhost:5173",
    "mcp:chrome": "npx chrome-devtools-mcp --help",
    "ci:lint": "eslint . --max-warnings=0",
    "ci:typecheck": "tsc --noEmit -p tsconfig.json",
    "ci:test": "npm run test --if-present",
    "ci:build": "vite build && node .SYSTEMX/scripts/assert-lan-isolation.mjs",
    "ci:audit": "npm audit --audit-level=high",
    "ci:security": "node .SYSTEMX/scripts/security-check.mjs && node .SYSTEMX/scripts/account-level-check.mjs && node .SYSTEMX/scripts/auth-mfa-readiness-check.mjs",
    "ci:ai": "node .SYSTEMX/scripts/agent-standard-check.mjs",
    "security:controls:test": "python3 -B -m unittest discover -s tests/security -v",
    "security:rules:test": "node --test tests/security/firestore-rules.test.mjs",
    "systemx": "bash .SYSTEMX/SYSTEMX.sh",
    "systemx:status": "python3 -B .SYSTEMX/manager.py status --target .",
    "systemx:validate": "bash .SYSTEMX/SYSTEMX.sh validate",
    "systemx:check": "bash .SYSTEMX/SYSTEMX.sh check",
    "systemx:context": "bash .SYSTEMX/SYSTEMX.sh context --agent agent.0",
    "systemx:upstream:check": "python3 -B scripts/sync-systemx.py",
    "systemx:upstream:import": "python3 -B scripts/sync-systemx.py --apply",
    "systemx:integration:test": "python3 -B -m unittest discover -s tests/systemx -v",
    "wiki:check": "bash scripts/sync-wiki.sh --dry-run",
    "wiki:sync": "bash scripts/sync-wiki.sh --apply",
    "template:check": "python3 -B scripts/validate-template.py",
    "template:sync": "python3 -B scripts/sync-template.py",
    "systemx:tools:test": "python3 -B scripts/test-systemx-tools.py",
    "ci:all": "bash scripts/check-template.sh",
    "hr:test": "node --test tests/hr/gusto-sdk-mock.test.mjs tests/hr/mock-workflows.test.mjs tests/hr/gusto-backend.test.mjs tests/hr/people-operations.test.mjs tests/hr/insights.test.mjs tests/hr/service-desk.test.mjs tests/hr/linked-operations.test.mjs tests/hr/recruiting.test.mjs tests/hr/recruiting-link.test.mjs tests/hr/performance.test.mjs tests/hr/surveys.test.mjs tests/hr/persistence.test.mjs",
    "hr:backend:audit": "npm --prefix integrations/gusto/functions audit --audit-level=high",
    "portals:test": "node --test tests/portals/cms.test.mjs tests/portals/crm.test.mjs tests/portals/storage.test.mjs tests/portals/persistence.test.mjs tests/portals/backup.test.mjs tests/portals/import-state.test.mjs tests/portals/combined-backup.test.mjs tests/portals/restore-workspaces.test.mjs tests/portals/restore-points.test.mjs",
    "backlog": "node scripts/webappx-backlog.mjs",
    "backlog:check": "node scripts/webappx-backlog.mjs --check",
    "backlog:render": "node scripts/webappx-backlog.mjs --write",
    "backlog:summary": "node scripts/webappx-backlog.mjs --summary",
    "backlog:test": "node --test tests/backlog/catalog.test.mjs"
  },
  "dependencies": {
    "@gusto/embedded-react-sdk": "0.56.6",
    "@tanstack/react-query": "5.104.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.484.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.1.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
