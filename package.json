    "browser:maturity": "node scripts/browser-maturity.mjs",
    "safety:test": "node --test tests/portals/unsaved-navigation.test.mjs tests/portals/cms-editor-recovery.test.mjs tests/portals/domain-differences.test.mjs tests/portals/recovery-preferences.test.mjs tests/portals/replacement-recovery.test.mjs tests/portals/replacement-epochs.test.mjs tests/portals/restore-point-kinds.test.mjs tests/hr/unsaved-forms.test.mjs tests/browser/portal-quality-auditor.test.mjs tests/browser/sdk-quality.test.mjs",
    "browser:safety": "node scripts/browser-safety.mjs",
    "browser:quality": "node scripts/browser-quality.mjs",
    "browser:recovery-drill": "node scripts/browser-recovery-drill.mjs",
    "browser:sdk-quality": "node scripts/browser-sdk-quality.mjs",
