#!/usr/bin/env bash
# .SYSTEMX/hooks/post-merge — Refresh the version tracker after merge/pull.
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel)"
VERSION_JSON="$ROOT_DIR/.SYSTEMX/webapp-version/version.json"
[[ -f "$VERSION_JSON" ]] || exit 0

BRANCH=$(git rev-parse --abbrev-ref HEAD)
PKG_VERSION=$(node -e 'console.log(require("./package.json").version)' 2>/dev/null || echo "0.0.0")

node - "$VERSION_JSON" "$PKG_VERSION" "$BRANCH" <<'NODE' 2>/dev/null || true
  const fs=require('fs');
  const [file, version, branch] = process.argv.slice(2);
  const v=JSON.parse(fs.readFileSync(file,'utf8'));
  v.app=v.app||{};
  v.app.version=version;
  v.app.branch=branch;
  v.app.lastUpdated=new Date().toISOString();
  fs.writeFileSync(file, JSON.stringify(v,null,2)+'\n');
NODE
echo "[post-merge] Version tracker updated: v$PKG_VERSION on $BRANCH"
