    { "family": "IBM Plex Sans", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["cyrillic", "latin", "latin-ext", "vietnamese"] },
    { "family": "Fira Code", "category": "monospace", "variants": ["400", "500", "600", "700"], "subsets": ["cyrillic", "latin", "latin-ext"] },
    { "family": "JetBrains Mono", "category": "monospace", "variants": ["400", "500", "600", "700"], "subsets": ["cyrillic", "latin", "latin-ext", "vietnamese"] },
    { "family": "Noto Sans", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["cyrillic", "devanagari", "greek", "latin", "latin-ext", "vietnamese"] }
