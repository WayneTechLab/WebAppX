    { "family": "Open Sans", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["cyrillic", "greek", "hebrew", "latin", "latin-ext", "vietnamese"] },
    { "family": "Source Sans 3", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["latin", "latin-ext", "vietnamese"] },
    { "family": "DM Sans", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["latin", "latin-ext"] },
    { "family": "Montserrat", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["cyrillic", "latin", "latin-ext", "vietnamese"] },
    { "family": "Poppins", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["devanagari", "latin", "latin-ext"] },
    { "family": "Space Grotesk", "category": "sans-serif", "variants": ["400", "500", "600", "700"], "subsets": ["latin", "latin-ext", "vietnamese"] },
