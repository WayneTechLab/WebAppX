{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "purpose": "Offline-first Google Fonts catalog for the SYSTEMX LAN font browser. Remote metadata is optional and never exposes an API key to the browser.",
