{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waynetechlab.com/systemx/component-registry.schema.json",
  "title": "SYSTEMX reusable component registry",
  "type": "object",
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "source", "tags", "responsive", "export"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kind": { "enum": ["component", "react-component", "module"] },
          "role": { "type": "string" },
          "source": { "type": "string", "maxLength": 500 },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "maxItems": 20 },
          "slots": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 20 },
          "responsive": { "type": "object", "additionalProperties": { "type": "string" } },
          "status": { "type": "string" },
          "export": {
            "type": "object",
            "required": ["format", "version"],
            "properties": { "format": { "const": "systemx-component" }, "version": { "const": 1 } }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
