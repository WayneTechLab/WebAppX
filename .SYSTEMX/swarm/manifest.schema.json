{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYSTEMX host swarm run manifest",
  "description": "Explicit adopted-run configuration. The template contains no active assignments or provider credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "repository", "baseBranch", "baseRevision", "maxWorkers", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "baseBranch": { "type": "string", "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9_/-]*$" },
    "baseRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 10 },
    "externalWorkers": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0 },
    "reservedPaths": { "type": "array", "items": { "type": "string", "maxLength": 512 }, "default": [] },
    "requiredChecks": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "uniqueItems": true, "default": [] },
    "autoMerge": { "type": "boolean", "default": false },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "acceptance", "allowedPaths", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "acceptance": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1400 } },
          "allowedPaths": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
          "checks": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["executable", "args"],
              "properties": {
                "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } }
              }
            }
          },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }, "default": [] }
        }
      }
    }
  }
}
