{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAppX scoped feature evidence index",
  "description": "Historical review attachments only. Proposal status and completion are deliberately absent. Runtime validation also checks known proposal IDs, calendar dates, revision relationships and existing repository-contained evidence files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "intent", "reviews"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "const": "WebAppX" },
    "intent": { "const": "scoped-feature-evidence" },
    "reviews": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewId", "proposalId", "examinedRevision", "reviewedOn", "scope", "evidence", "limitations"],
        "properties": {
          "reviewId": { "type": "string", "pattern": "^WXR-[0-9]{4}$" },
          "proposalId": { "type": "string", "pattern": "^WX-[0-9]{4}$" },
          "examinedRevision": { "$ref": "#/$defs/revision" },
          "reviewedOn": { "type": "string", "format": "date" },
          "scope": { "$ref": "#/$defs/scope" },
          "limitations": { "type": "string", "minLength": 12, "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "reference", "observedOn", "observationRevision", "revisionBasis", "scope"],
              "properties": {
                "category": { "enum": ["local", "browser", "provider", "operator"] },
                "reference": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 240,
                  "description": "An existing repository-relative regular file. URLs, absolute paths, queries, fragments, percent escapes, backslashes, empty segments and dot segments are rejected by the CLI, as are symlinks that escape the repository."
                },
                "observedOn": { "type": "string", "format": "date", "description": "Original observation date, no later than reviewedOn." },
                "observationRevision": { "$ref": "#/$defs/revision" },
                "revisionBasis": {
                  "enum": ["examined-source", "receipt-source-base"],
                  "description": "examined-source must equal examinedRevision. receipt-source-base retains the source base named by an earlier receipt, which need not identify its exact final build."
                },
                "scope": { "$ref": "#/$defs/scope" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "scope": { "type": "string", "minLength": 12, "maxLength": 700, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
  }
}
