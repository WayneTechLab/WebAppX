{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAppX 1,000-item improvement catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "intent",
    "createdOn",
    "sourceCommit",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "const": "WebAppX"
    },
    "intent": {
      "const": "proposed-backlog"
    },
    "createdOn": {
      "type": "string",
      "format": "date"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "items": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "priority",
          "phase",
          "status",
          "title",
          "acceptance",
          "source",
          "gate",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WX-[0-9]{4}$"
          },
          "area": {
            "enum": [
              "setup",
              "portal-shell",
              "hr-onboarding",
              "hr-payroll",
              "hr-talent",
              "cms-authoring",
              "cms-publishing",
              "crm-contacts",
              "crm-sales",
              "mock-recovery",
              "identity",
              "firebase",
              "security",
              "quality",
              "design",
              "operations",
              "delivery",
              "systemx",
              "adoption",
              "integrations"
            ]
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "phase": {
            "enum": [
              "foundation",
              "portal-maturity",
              "production-readiness",
              "extensions"
            ]
          },
          "status": {
            "enum": ["todo", "done"]
          },
          "title": {
            "type": "string",
            "minLength": 18,
            "maxLength": 180
          },
          "acceptance": {
            "type": "string",
            "minLength": 30,
            "maxLength": 700
          },
          "source": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "gate": {
            "enum": [
              "local",
              "provider",
              "operator"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^WX-[0-9]{4}$"
            }
          },
          "completion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verifiedOn", "sourceBase", "evidence", "reviewedBy"],
            "properties": {
              "verifiedOn": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "sourceBase": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "evidence": {
                "type": "string",
                "minLength": 2,
                "maxLength": 240,
                "description": "Existing repository-relative file. The CLI also resolves real paths and rejects paths escaping the repository."
              },
              "reviewedBy": {
                "enum": ["agent.0", "user"]
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "done" } } },
            "then": { "required": ["completion"] },
            "else": { "not": { "required": ["completion"] } }
          }
        ]
      }
    }
  }
}
