{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAppX reviewed adoption plan",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "createdAt", "source", "target", "selection", "mapping", "tasks", "gateAssessments", "intake", "boundary", "planSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "webappx-backlog-adoption-plan" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "catalogSha256", "provenance"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "provenance": { "enum": ["verified-local-commit", "fixture-captured-facts"] }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "app", "scope", "records", "fingerprint"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "app": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scope": { "type": "string", "minLength": 1 },
        "records": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "selection": { "$ref": "webappx-adoption-selection.schema.json" },
    "mapping": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["proposalId", "taskId", "owner", "dependsOn"],
        "properties": {
          "proposalId": { "type": "string", "pattern": "^WX-[0-9]{4}$" },
          "taskId": { "$ref": "#/$defs/taskId" },
          "owner": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } }
        }
      }
    },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/task" } },
    "gateAssessments": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/assessment" } },
    "intake": {
      "type": "object", "additionalProperties": false,
      "required": ["executionAuthorized", "requiresExplicitIntakeAction"],
      "properties": { "executionAuthorized": { "const": false }, "requiresExplicitIntakeAction": { "const": true } }
    },
    "boundary": { "type": "string", "minLength": 1 },
    "planSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taskId": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["at", "status", "owner", "note", "evidence", "reviewedBy"],
      "properties": {
        "at": { "type": "string", "format": "date-time" }, "status": { "const": "todo" },
        "owner": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "maxItems": 0 }, "reviewedBy": { "const": "" }
      }
    },
    "task": {
      "description": "Exact selected SYSTEMX TASK fields. Upstream validators additionally enforce owners, dependencies and chronological history.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "owner", "status", "milestone", "scope", "acceptance", "dependsOn", "nextAction", "blocker", "evidence", "reviewedBy", "createdAt", "updatedAt", "history"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" }, "title": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }, "status": { "const": "todo" }, "milestone": { "const": "" },
        "scope": { "$ref": "#/$defs/strings" },
        "acceptance": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1 } },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "nextAction": { "type": "string" }, "blocker": { "const": "" },
        "evidence": { "type": "array", "maxItems": 0 }, "reviewedBy": { "const": "" },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
        "history": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/history" } }
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reason", "requirement", "observation"],
      "properties": {
        "state": { "enum": ["unknown", "blocked", "not_required", "reported_ready"] },
        "reason": { "type": "string" },
        "requirement": { "oneOf": [ { "type": "null" }, { "$ref": "webappx-adoption-gates.schema.json#/$defs/namesRequirement" }, { "$ref": "webappx-adoption-gates.schema.json#/$defs/authorizationRequirement" } ] },
        "observation": { "type": ["null", "array", "object"] }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["proposalId", "criterionSha256", "sourceGate", "action", "target", "dimensions", "dependencies", "dependencyReadiness", "executionReadiness"],
      "properties": {
        "proposalId": { "type": "string", "pattern": "^WX-[0-9]{4}$" },
        "criterionSha256": { "$ref": "#/$defs/sha256" }, "sourceGate": { "enum": ["local", "provider", "operator"] },
        "action": { "type": ["null", "string"] }, "target": { "type": ["null", "string"] },
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["credentials", "operatorAuthorization", "localPrerequisites"],
          "properties": { "credentials": { "$ref": "#/$defs/dimension" }, "operatorAuthorization": { "$ref": "#/$defs/dimension" }, "localPrerequisites": { "$ref": "#/$defs/dimension" } }
        },
        "dependencies": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["taskId", "status"],
            "properties": { "taskId": { "$ref": "#/$defs/taskId" }, "status": { "enum": ["todo", "in_progress", "blocked", "needs_review", "done", "cancelled"] } }
          }
        },
        "dependencyReadiness": { "enum": ["recorded_ready", "blocked"] },
        "executionReadiness": { "enum": ["unknown", "blocked", "reported_ready"] }
      }
    }
  }
}
