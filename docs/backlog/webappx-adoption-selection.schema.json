{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAppX bounded adoption selection",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "tasks", "dependencies", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["proposalId", "owner", "scope", "nextAction"],
        "properties": {
          "proposalId": { "type": "string", "pattern": "^WX-[0-9]{4}$" },
          "owner": { "type": "string", "minLength": 1, "maxLength": 80 },
          "scope": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
          "nextAction": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "dependencies": {
      "description": "Every external WX dependency requires a reviewed existing TASK binding, including source proposals already marked done.",
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["proposalId", "taskId", "reviewedBy", "reference"],
        "properties": {
          "proposalId": { "type": "string", "pattern": "^WX-[0-9]{4}$" },
          "taskId": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
          "reviewedBy": { "enum": ["agent.0", "user"] },
          "reference": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "gates": { "type": "array", "maxItems": 40, "items": { "$ref": "webappx-adoption-gates.schema.json#/$defs/gate" } }
  }
}
