{
  "schemaVersion": 1,
  "scope": "organizations/{orgId}",
  "identity": "Application organization/person IDs are canonical; vendor IDs live in backend-only mappings.",
  "secrets": "Never store SSNs, bank details, tax answers, Gusto client secrets, access/refresh tokens, full paystubs or signed provider PDFs in these collections.",
  "collections": {
    "hr_memberships": { "key": "firebaseUid", "authority": "systemx-server", "classification": "authorization", "fields": ["uid", "orgId", "status", "roles", "personId", "gustoEmployeeUuid", "gustoContractorUuid"], "client": "deny; authority and mappings backend-only" },
    "integrations": { "key": "gusto", "authority": "systemx-server", "classification": "provider-mapping", "fields": ["orgId", "mode", "status", "gustoCompanyUuid", "sdkVersion", "apiVersion", "acceptedAt"], "client": "deny" },
    "hr_people": { "key": "personId", "authority": "projection", "classification": "directory", "fields": ["orgId", "personId", "displayName", "workEmail", "type", "employmentStatus", "departmentId", "jobTitle", "managerPersonId"], "client": "scoped reads; backend writes" },
    "hr_employment": { "key": "employmentId", "authority": "gusto-projection", "classification": "restricted-hr", "fields": ["orgId", "personId", "employmentId", "startDate", "endDate", "status", "onboardingStatus", "providerVersion"], "client": "own person or authorized HR roles read; backend writes" },
    "hr_contractors": { "key": "personId", "authority": "gusto-projection", "classification": "restricted-hr", "fields": ["orgId", "personId", "contractorType", "status", "onboardingStatus"], "client": "deny until contractor adapter accepted" },
    "hr_restricted_profiles": { "key": "personId", "authority": "gusto-live-or-minimal-projection", "classification": "restricted-hr", "fields": ["orgId", "personId", "reviewedOptionalFields"], "client": "own person or authorized HR roles read; backend writes" },
    "hr_compensation": { "key": "personId", "authority": "gusto-projection", "classification": "restricted-hr", "fields": ["orgId", "personId", "payType", "currency", "amount", "effectiveAt"], "client": "own person or authorized HR roles read; backend writes" },
    "hr_departments": { "key": "departmentId", "authority": "systemx", "classification": "organization", "fields": ["orgId", "departmentId", "name", "managerPersonId"], "client": "member reads; backend writes" },
    "hr_locations": { "key": "locationId", "authority": "gusto-projection", "classification": "organization", "fields": ["orgId", "locationId", "name", "status"], "client": "member reads; backend writes" },
    "hr_jobs": { "key": "jobId", "authority": "systemx-and-gusto-mapped", "classification": "organization", "fields": ["orgId", "jobId", "title", "departmentId", "status"], "client": "member reads; backend writes" },
    "hr_pay_schedules": { "key": "scheduleId", "authority": "gusto-projection", "classification": "payroll", "fields": ["orgId", "scheduleId", "name", "frequency", "nextCheckDate"], "client": "deny until provider adapter accepted" },
    "hr_onboarding": { "key": "workflowId", "authority": "systemx-with-provider-state", "classification": "person-workflow", "fields": ["orgId", "workflowId", "personId", "employmentId", "stage", "nativeChecklist", "providerOnboardingStatus"], "client": "deny until lifecycle adapter accepted" },
    "hr_time_entries": { "key": "entryId", "authority": "systemx-or-time-provider", "classification": "person-workflow", "fields": ["orgId", "entryId", "personId", "startAt", "endAt", "breakMinutes", "status", "approvedBy"], "client": "deny until time approval adapter accepted" },
    "hr_time_off_policies": { "key": "policyId", "authority": "systemx-or-gusto-mapped", "classification": "organization", "fields": ["orgId", "policyId", "name", "status", "provider", "units"], "client": "member reads; backend writes" },
    "hr_time_off_requests": { "key": "requestId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "requestId", "personId", "firebaseUid", "policyId", "startAt", "endAt", "hours", "note", "status", "source", "createdAt"], "client": "validated own create; own or authorized HR reads; updates backend-only" },
    "hr_payroll_runs": { "key": "payrollId", "authority": "gusto-projection", "classification": "payroll", "fields": ["orgId", "payrollId", "status", "payPeriodStart", "payPeriodEnd", "checkDate", "source"], "client": "owner/payroll-admin/auditor read; backend writes" },
    "hr_contractor_payments": { "key": "paymentId", "authority": "gusto-projection", "classification": "payroll", "fields": ["orgId", "paymentId", "status", "paymentDate"], "client": "owner/payroll-admin/auditor read; backend writes" },
    "hr_benefit_catalog": { "key": "benefitId", "authority": "provider-or-native-catalog", "classification": "organization", "fields": ["orgId", "benefitId", "name", "provider", "status"], "client": "deny until benefits adapter accepted" },
    "hr_benefit_enrollments": { "key": "enrollmentId", "authority": "gusto-or-benefits-provider", "classification": "restricted-hr", "fields": ["orgId", "enrollmentId", "personId", "benefitId", "status", "effectiveAt"], "client": "deny until benefit enrollment adapter accepted" },
    "hr_documents": { "key": "documentId", "authority": "systemx-metadata-or-provider-live", "classification": "person-workflow", "fields": ["orgId", "documentId", "personId", "name", "kind", "status", "storageClass"], "client": "scoped metadata reads; no provider PDF payload or secret URLs" },
    "hr_information_requests": { "key": "requestId", "authority": "gusto-projection", "classification": "restricted-hr", "fields": ["orgId", "requestId", "personId", "status", "providerVersion"], "client": "deny until provider adapter accepted" },
    "hr_tasks": { "key": "taskId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "taskId", "personId", "title", "status", "dueAt"], "client": "scoped reads; backend writes" },
    "hr_policies": { "key": "policyId", "authority": "systemx", "classification": "organization", "fields": ["orgId", "policyId", "title", "version", "status"], "client": "member reads; backend writes" },
    "hr_policy_acknowledgements": { "key": "ackId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "ackId", "personId", "policyId", "version", "acknowledgedAt"], "client": "scoped reads; backend writes" },
    "hr_assets": { "key": "assetId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "assetId", "personId", "label", "status"], "client": "scoped reads; backend writes" },
    "hr_asset_assignments": { "key": "assignmentId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "assignmentId", "personId", "assetId", "assignedAt", "returnedAt"], "client": "scoped reads; backend writes" },
    "hr_training": { "key": "trainingId", "authority": "systemx", "classification": "organization", "fields": ["orgId", "trainingId", "title", "version", "status"], "client": "member reads; backend writes" },
    "hr_certifications": { "key": "certificationId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "certificationId", "personId", "trainingId", "completedAt", "expiresAt"], "client": "scoped reads; backend writes" },
    "hr_performance_cycles": { "key": "cycleId", "authority": "systemx", "classification": "restricted-hr", "fields": ["orgId", "cycleId", "name", "startAt", "endAt", "status"], "client": "deny until performance adapter accepted" },
    "hr_reviews": { "key": "reviewId", "authority": "systemx", "classification": "person-workflow", "fields": ["orgId", "reviewId", "personId", "cycleId", "status", "publishedSummary"], "client": "scoped reads; private reviewer notes must use a separate backend-only document" },
    "hr_reports": { "key": "reportId", "authority": "systemx-derived", "classification": "payroll", "fields": ["orgId", "reportId", "kind", "period", "aggregate", "generatedAt"], "client": "owner/payroll-admin/auditor read; no secret payroll exports" },
    "hr_external_ids": { "key": "mappingId", "authority": "systemx-server", "classification": "provider-mapping", "fields": ["orgId", "personId", "kind", "externalId", "companyUuid"], "client": "deny" },
    "hr_sync_state": { "key": "resource", "authority": "systemx-server", "classification": "operations", "fields": ["orgId", "resource", "cursor", "lastReconciledAt", "state"], "client": "deny" },
    "hr_webhook_inbox": { "key": "eventUuid", "authority": "signed-provider-event", "classification": "operations", "fields": ["orgId", "eventId", "bodyHash", "companyUuid", "entityUuid", "entityType", "eventType", "occurredAtSeconds", "receivedAtSeconds", "state", "attempts"], "client": "deny" },
    "hr_idempotency": { "key": "requestKeyHash", "authority": "systemx-server", "classification": "operations", "fields": ["orgId", "action", "resourceId", "payloadHash", "state", "createdAt", "expiresAt"], "client": "deny" },
    "hr_audit_events": { "key": "eventId", "authority": "systemx-server", "classification": "operations", "fields": ["orgId", "actorUid", "action", "resourceId", "result", "mode", "createdAt"], "client": "deny" }
  }
}
